{
  "doctype": "DocType",
  "name": "NCE Theme Settings",
  "module": "NCE Studio",
  "issingle": 1,
  "fields": [
    {"fieldname": "section_colours",    "fieldtype": "Section Break", "label": "Colours"},
    {"fieldname": "primary_color",      "fieldtype": "Color",         "label": "Primary",          "default": "#3B82F6"},
    {"fieldname": "secondary_color",    "fieldtype": "Color",         "label": "Secondary",        "default": "#6B7280"},
    {"fieldname": "accent_color",       "fieldtype": "Color",         "label": "Accent",           "default": "#10B981"},
    {"fieldname": "success_color",      "fieldtype": "Color",         "label": "Success",          "default": "#10B981"},
    {"fieldname": "warning_color",      "fieldtype": "Color",         "label": "Warning",          "default": "#F59E0B"},
    {"fieldname": "danger_color",       "fieldtype": "Color",         "label": "Danger",           "default": "#EF4444"},
    {"fieldname": "info_color",         "fieldtype": "Color",         "label": "Info",             "default": "#3B82F6"},
    {"fieldname": "gray_color",         "fieldtype": "Color",         "label": "Gray",             "default": "#9CA3AF"},
    {"fieldname": "text_color",         "fieldtype": "Color",         "label": "Text",             "default": "#1F2937"},
    {"fieldname": "text_muted_color",   "fieldtype": "Color",         "label": "Text Muted",       "default": "#6B7280"},
    {"fieldname": "background_color",   "fieldtype": "Color",         "label": "Background",       "default": "#FFFFFF"},
    {"fieldname": "surface_color",      "fieldtype": "Color",         "label": "Surface",          "default": "#F9FAFB"},
    {"fieldname": "border_color",       "fieldtype": "Color",         "label": "Border",           "default": "#E5E7EB"},
    {"fieldname": "link_color",         "fieldtype": "Color",         "label": "Link",             "default": "#3B82F6"},
    {"fieldname": "focus_ring_color",   "fieldtype": "Color",         "label": "Focus Ring",       "default": "#3B82F6"},
    {"fieldname": "shadow_color",       "fieldtype": "Color",         "label": "Shadow",           "default": "#000000"},
    {"fieldname": "section_typography", "fieldtype": "Section Break", "label": "Typography"},
    {"fieldname": "font_family",        "fieldtype": "Data",          "label": "Font Family",      "default": "Inter, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif"},
    {"fieldname": "font_size_base",     "fieldtype": "Data",          "label": "Font Size Base",   "default": "1rem"},
    {"fieldname": "font_weight_base",   "fieldtype": "Data",          "label": "Font Weight Base", "default": "400"},
    {"fieldname": "line_height_base",   "fieldtype": "Data",          "label": "Line Height Base", "default": "1.5"},
    {"fieldname": "section_layout",     "fieldtype": "Section Break", "label": "Layout"},
    {"fieldname": "border_radius",      "fieldtype": "Data",          "label": "Border Radius",    "default": "0.375rem"},
    {"fieldname": "spacing_unit",       "fieldtype": "Data",          "label": "Spacing Unit",     "default": "0.25rem"},
    {"fieldname": "shadow_style",       "fieldtype": "Select",        "label": "Shadow Style",     "options": "sm\nDEFAULT\nmd\nlg\nxl", "default": "sm"},
    {"fieldname": "max_content_width",  "fieldtype": "Data",          "label": "Max Content Width","default": "1280px"},
    {"fieldname": "sidebar_width",      "fieldtype": "Data",          "label": "Sidebar Width",    "default": "280px"},
    {"fieldname": "transition_speed",   "fieldtype": "Data",          "label": "Transition Speed", "default": "0.2s"},
    {"fieldname": "section_custom",     "fieldtype": "Section Break", "label": "Custom"},
    {"fieldname": "custom_css",         "fieldtype": "Code",          "label": "Custom CSS",       "options": "CSS"},
    {"fieldname": "tailwind_overrides", "fieldtype": "Code",          "label": "Tailwind Overrides","options": "JSON"}
  ],
  "permissions": [
    {"role": "System Manager", "read": 1, "write": 1, "create": 1, "delete": 1}
  ]
}
